{
  "name": "spaces",
  "version": "0.1.0",
  "private": true,
  "description": "OverlayFS management system with web UI",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:daemon": "pnpm --filter @spaces/daemon dev",
    "dev:web": "pnpm --filter @spaces/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20"
  }
}
