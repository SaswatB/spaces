        "properties": {
          "changeType": {
            "$ref": "#/components/schemas/FileChangeType"
          },
          "relativePath": {
            "type": "string"
          },
          "sourceGid": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "sourceUid": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FileChangeType": {
        "type": "string",
        "enum": [
          "add",
          "modify",
          "delete"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Layer": {
        "type": "object",
        "required": [
          "id",
          "name",
          "entrypointId",
          "upperDir",
          "workDir",
          "mountPath",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "entrypointId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "mountPath": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
