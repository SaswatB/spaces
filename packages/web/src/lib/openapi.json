        "type": "object",
        "required": [
          "id",
          "name",
          "entrypointId",
          "upperDir",
          "workDir",
          "mountPath",
          "mountStatus",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "entrypointId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "mountPath": {
            "type": "string"
          },
          "mountStatus": {
            "$ref": "#/components/schemas/MountStatus"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "upperDir": {
            "type": "string"
          },
          "workDir": {
            "type": "string"
          }
        }
      },
      "ListQuery": {
        "type": "object",
        "properties": {
          "entrypointId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "MountStatus": {
        "type": "string",
        "enum": [
          "mounted",
          "unmounted",
          "error"
        ]
      },
      "StatusResponse": {
        "type": "object",
        "required": [
          "entrypointCount",
          "layerCount",
          "userMountCount",
          "mountedLayers",
          "mountedUserMounts"
        ],
        "properties": {
          "entrypointCount": {
            "type": "integer",
            "minimum": 0
          },
          "layerCount": {
            "type": "integer",
            "minimum": 0
          },
          "mountedLayers": {
            "type": "integer",
            "minimum": 0
          },
          "mountedUserMounts": {
            "type": "integer",
            "minimum": 0
          },
          "userMountCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SyncState": {
        "type": "object",
        "required": [
          "userMountId",
          "status",
          "pendingChanges"
        ],
        "properties": {
          "error": {
            "type": "string",
            "nullable": true
          },
          "lastSyncedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pendingChanges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileChange"
            }
          },
          "status": {
            "$ref": "#/components/schemas/SyncStatus"
          },
          "userMountId": {
            "type": "string"
          }
        }
      },
      "SyncStatus": {
        "type": "string",
        "enum": [
          "idle",
          "syncing",
          "error"
        ]
      },
      "UserMount": {
        "type": "object",
        "required": [
          "id",
          "name",
          "entrypointId",
          "mountPath",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "attachedLayerId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "entrypointId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "mountPath": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserMountResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "entrypointId",
          "mountPath",
          "mountStatus",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "attachedLayerId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "entrypointId": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "mountPath": {
            "type": "string"
          },
          "mountStatus": {
            "$ref": "#/components/schemas/MountStatus"
          },
          "name": {
            "type": "string"
          },
          "syncState": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SyncState"
              }
            ],
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
